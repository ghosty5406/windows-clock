{
  "name": "windows-clock",
  "version": "1.0.0",
  "description": "Economiseur d'ecran Windows multi-ecrans : horloge plein ecran, verrouillage par Windows a la reprise",
  "main": "main.js",
  "scripts": {
    "start": "electron . /s",
    "build": "node tools/build-scr.js",
    "package": "node tools/package.js",
